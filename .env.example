# --- Google Calendar (service account) ---
# Path to the service-account JSON key file you download from Google Cloud Console.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json
# The calendar to book into. Use the hospital's calendar ID (Calendar Settings > Integrate calendar > Calendar ID).
# The service account's email must be shared on this calendar with "Make changes to events" permission.
GOOGLE_CALENDAR_ID=primary

# --- Clinic scheduling rules ---
TIMEZONE=Asia/Karachi
APPOINTMENT_DURATION_MINUTES=30
CLINIC_OPEN_HOUR=9
CLINIC_CLOSE_HOUR=17
# Comma separated, 0=Sunday ... 6=Saturday. Default below = Mon-Sat.
CLINIC_WORKING_DAYS=1,2,3,4,5,6

# --- Security ---
# Shared secret you also paste into the Vapi tool's custom headers, so random
# internet traffic can't call your booking endpoints.
VAPI_TOOL_SECRET=change-me-to-a-long-random-string

# --- Server ---
PORT=3000
